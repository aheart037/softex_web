# ================================================================
#  Softex Technologies — .htaccess
#  Place in: public_html/  (your website root)
# ================================================================

Options -Indexes
Options +FollowSymLinks

# ================================================================
#  CUSTOM ERROR PAGES (works even without mod_rewrite)
# ================================================================
ErrorDocument 400 /404.php
ErrorDocument 401 /404.php
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php
ErrorDocument 500 /404.php
ErrorDocument 503 /404.php

# ================================================================
#  MOD_REWRITE RULES
# ================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Skip real files and directories ──────────────────────────
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ── Route all unknown URLs to 404.php ────────────────────────
  RewriteRule ^ 404.php [L]

  # ── Force HTTPS (comment out if your host manages this) ──────
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

</IfModule>

# ================================================================
#  PERFORMANCE: Compression
# ================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ================================================================
#  PERFORMANCE: Browser Caching
# ================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png          "access plus 1 month"
  ExpiresByType image/jpeg         "access plus 1 month"
  ExpiresByType image/gif          "access plus 1 month"
  ExpiresByType image/webp         "access plus 1 month"
  ExpiresByType image/svg+xml      "access plus 1 month"
  ExpiresByType image/x-icon       "access plus 1 year"
  ExpiresByType text/css           "access plus 2 weeks"
  ExpiresByType application/javascript "access plus 2 weeks"
  ExpiresByType text/html          "access plus 1 hour"
</IfModule>

# ================================================================
#  SECURITY
# ================================================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Block access to sensitive files ────────────────────────────
<FilesMatch "^(\.htaccess|\.env|\.git|composer\.json|package\.json|error_log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
